#######################################
# Loads a named palette, defining every colour in it.
# Colour names are capitalised, so 'peach' becomes PL_COLORS[Peach].
#
# Globals:
#   PL_COLORS, __PL_PALETTES, __PL_PALETTE_CURRENT
# Arguments:
#   $1: palette name, as listed by 'pureline theme list'. Defaults to
#       catppuccin_mocha.
# Returns:
#   0 on success, 1 if there is no such palette.
#######################################
pl_load_palette() {
  local palette=${1:-catppuccin_mocha}
  local entry name

  if [[ -z ${__PL_PALETTES[${palette}]+set} ]]; then
    echo "pureline: unknown palette '${palette}'" >&2
    return 1
  fi

  # Unquoted on purpose: a palette is a whitespace-separated list of
  # name=hex words, none of which can contain glob characters.
  # shellcheck disable=SC2086
  for entry in ${__PL_PALETTES[${palette}]}; do
    name=${entry%%=*}
    pl_define_color "${name^}" "${entry#*=}"
  done
  __PL_PALETTE_CURRENT=${palette}
}

#######################################
# Defines the escape sequences that are not colours, plus the ANSI base
# colours kept for backwards compatibility with older configs.
# Globals:
#   PL_COLORS
#######################################
__pl_set_base_colors() {
  PL_COLORS[Color_Off]='\[\e[0m\]'
  PL_COLORS[Bold]='\[\e[1m\]'
  PL_COLORS[Dim]='\[\e[2m\]'
  PL_COLORS[Italic]='\[\e[3m\]'
  PL_COLORS[Underline]='\[\e[4m\]'

  # 'Default' means "whatever the terminal's own default is". It is what
  # segment caps and the trailing reset are drawn against.
  PL_COLORS[Default]='\[\e[39m\]'
  PL_COLORS[On_Default]='\[\e[49m\]'

  # The original 8 ANSI names. A palette may override some of these (it
  # redefines Red, Green, Yellow and Blue); the rest remain available so
  # that configs written against stock pureline keep working.
  PL_COLORS[Black]='\[\e[30m\]';   PL_COLORS[On_Black]='\[\e[40m\]'
  PL_COLORS[Red]='\[\e[31m\]';     PL_COLORS[On_Red]='\[\e[41m\]'
  PL_COLORS[Green]='\[\e[32m\]';   PL_COLORS[On_Green]='\[\e[42m\]'
  PL_COLORS[Yellow]='\[\e[33m\]';  PL_COLORS[On_Yellow]='\[\e[43m\]'
  PL_COLORS[Blue]='\[\e[34m\]';    PL_COLORS[On_Blue]='\[\e[44m\]'
  PL_COLORS[Purple]='\[\e[35m\]';  PL_COLORS[On_Purple]='\[\e[45m\]'
  PL_COLORS[Cyan]='\[\e[36m\]';    PL_COLORS[On_Cyan]='\[\e[46m\]'
  PL_COLORS[White]='\[\e[37m\]';   PL_COLORS[On_White]='\[\e[47m\]'
}

#######################################
# Locates an executable on PATH without forking.
#
# 'type -P' would need a command substitution to capture, which costs about
# as much as a fork; walking PATH with [[ -x ]] costs a handful of stat
# calls. Results are cached, and the cache is dropped whenever PATH changes
# so that version managers (nvm, asdf, mise) are picked up immediately.
#
# Globals:
#   PATH, __PL_PATH_CACHE, __PL_PATH_SNAPSHOT
# Arguments:
#   $1: command name.
# Outputs:
#   Sets __pl_locate_result to the absolute path on success.
# Returns:
#   0 if found, 1 otherwise.
#######################################
__pl_locate() {
  local cmd=$1
  local dir rest

  if [[ ${__PL_PATH_SNAPSHOT} != "${PATH}" ]]; then
    __PL_PATH_CACHE=()
    __PL_PATH_SNAPSHOT=${PATH}
  fi

  if [[ -n ${__PL_PATH_CACHE[${cmd}]+set} ]]; then
    __pl_locate_result=${__PL_PATH_CACHE[${cmd}]}
    [[ -n ${__pl_locate_result} ]]
    return
  fi

  rest=${PATH}
  while [[ -n ${rest} ]]; do
    dir=${rest%%:*}
    if [[ ${rest} == *:* ]]; then
      rest=${rest#*:}
    else
      rest=''
    fi
    if [[ -n ${dir} && -x ${dir}/${cmd} && ! -d ${dir}/${cmd} ]]; then
      __PL_PATH_CACHE[${cmd}]="${dir}/${cmd}"
      __pl_locate_result="${dir}/${cmd}"
      return 0
    fi
  done

  __PL_PATH_CACHE[${cmd}]=''
  __pl_locate_result=''
  return 1
}

#######################################
# Escapes text so that it renders literally in the prompt.
#
# When the 'promptvars' shell option is set -- which it is by default --
# bash runs parameter expansion, command substitution and arithmetic
# expansion over PS1 every time it draws the prompt. Anything interpolated
# into PS1 is therefore live code: a directory or branch named
# '$(rm -rf ~)' would be executed on every prompt, and a '$' in a symbol
# would silently vanish as an undefined variable.
#
# The encodings below survive both prompt decoding and that second pass:
#   \  ->  \\\\      $  ->  \\$      `  ->  \\`
# Backslashes are handled first so the escapes added afterwards are not
# themselves re-escaped.
#
# Arguments:
#   $1: arbitrary text.
# Outputs:
#   Sets __pl_escaped. This is a single shared global, so a nested call
#   overwrites it: read the result before calling anything that escapes.
#######################################
__pl_escape() {
  local text=$1
  text=${text//\\/\\\\\\\\}
  text=${text//\$/\\\\\$}
  text=${text//\`/\\\\\`}
  __pl_escaped=$text
}

#######################################
# Appends the separator that transitions into the next segment.
#
# Three cases, matching how a powerline prompt is drawn:
#   - first segment on the line: a rounded opening cap, in the segment's
#     background colour, over the terminal default background;
#   - same background as the previous segment: a thin soft separator, so
#     adjacent same-coloured segments stay visually distinct;
#   - different background: the solid arrow, drawn in the previous
#     background over the next one.
#
# Globals:
#   PS1, PL_COLORS, PL_SYMBOLS, __last_color
# Arguments:
#   $1: background colour name of the segment being opened.
#   $2: foreground colour name of the segment being opened.
#######################################
__pl_separator() {
  if [[ -z ${__last_color} ]]; then
    [[ -z ${PL_SYMBOLS[segment_head]} ]] && return
    __pl_escape "${PL_SYMBOLS[segment_head]}"
    PS1+="${PL_COLORS[On_Default]}${PL_COLORS[$1]}${__pl_escaped}"
  elif [[ ${__last_color} == "$1" ]]; then
    # A blank soft separator means the two segments are meant to read as one
    # block, so emit nothing at all rather than a colour change with no glyph.
    [[ -z ${PL_SYMBOLS[soft_separator]} ]] && return
    __pl_escape "${PL_SYMBOLS[soft_separator]}"
    PS1+="${PL_COLORS[$2]}${PL_COLORS[On_$1]}${__pl_escaped}"
  else
    PS1+="${PL_COLORS[${__last_color}]}${PL_COLORS[On_$1]}"
    __pl_escape "${PL_SYMBOLS[hard_separator]}"
    PS1+="${__pl_escaped}"
  fi
}

#######################################
# Collapses doubled padding where a segment joins the previous one with no
# visible separator.
#
# Every segment pads its own content with a space on each side so that it
# looks right standing alone. When two segments share a background and the
# soft separator is blank they are meant to read as a single block, and
# those two paddings meet, giving a double space. This drops one of them.
#
# Globals:
#   PS1, PL_SYMBOLS, __last_color
# Arguments:
#   $1: background colour name of the segment being added.
#   $2: its content.
# Outputs:
#   Sets __pl_content to the content, with the leading space removed when
#   the segment joins the previous one seamlessly.
#######################################
__pl_join() {
  __pl_content=$2
  [[ -z ${__last_color} ]] && return
  [[ ${__last_color} != "$1" ]] && return
  [[ -n ${PL_SYMBOLS[soft_separator]} ]] && return
  if [[ ${PS1} == *' ' && ${__pl_content} == ' '* ]]; then
    __pl_content=${__pl_content# }
  fi
}

#######################################
# Appends one segment to the prompt. This is the helper every segment uses,
# and the reason the prompt no longer forks: it writes into PS1 directly.
#
# Globals:
#   PS1, PL_COLORS, __last_color
# Arguments:
#   $1: background colour name.
#   $2: foreground colour name.
#   $3: content, including any padding spaces.
#######################################
pl_add_segment() {
  __pl_join "$1" "$3"
  # Order matters: __pl_separator escapes its own glyph into __pl_escaped,
  # so the content must be escaped after it has run, not before.
  __pl_separator "$1" "$2"
  __pl_escape "${__pl_content}"
  PS1+="${PL_COLORS[$2]}${PL_COLORS[On_$1]}${__pl_escaped}"
  __last_color=$1
}

#######################################
# As pl_add_segment, but without escaping. Only for content that is meant
# to contain bash prompt escapes such as \u, \h, \A or \t. Never pass
# anything derived from a path, a branch name or other outside input.
#
# Globals:
#   PS1, PL_COLORS, __last_color
# Arguments:
#   $1: background colour name.
#   $2: foreground colour name.
#   $3: content, including any padding spaces.
#######################################
pl_add_segment_raw() {
  __pl_join "$1" "$3"
  __pl_separator "$1" "$2"
  PS1+="${PL_COLORS[$2]}${PL_COLORS[On_$1]}${__pl_content}"
  __last_color=$1
}

#######################################
# Closes the current run of segments with a rounded cap.
# Globals:
#   PS1, PL_COLORS, PL_SYMBOLS, __last_color
#######################################
__pl_close_line() {
  if [[ -n ${__last_color} ]]; then
    PS1+="${PL_COLORS[On_Default]}${PL_COLORS[${__last_color}]}"
    __pl_escape "${PL_SYMBOLS[segment_tail]}"
    PS1+="${__pl_escaped}"
  fi
  __last_color=''
}

#######################################
# Backwards-compatible shim for third-party segments written against the
# original pureline API. Correct, but it forks; prefer pl_add_segment.
# Arguments:
#   $1: foreground colour name.
#   $2: background colour name.
# Outputs:
#   Writes the separator to stdout.
#######################################
segment_end() {
  local end_char fg
  if [[ ${__last_color} == "$2" ]]; then
    end_char=${PL_SYMBOLS[soft_separator]}
    fg=$1
  else
    end_char=${PL_SYMBOLS[hard_separator]}
    fg=${__last_color}
  fi
  if [[ -n ${__last_color} ]]; then
    echo "${PL_COLORS[${fg}]}${PL_COLORS[On_$2]}${end_char}"
  else
    echo "${PL_COLORS[On_Default]}${PL_COLORS[$2]}${PL_SYMBOLS[segment_head]}"
  fi
}

#######################################
# Backwards-compatible shim. See segment_end.
# Arguments:
#   $1: foreground colour name.
#   $2: background colour name.
#   $3: content.
# Outputs:
#   Writes the coloured content to stdout.
#######################################
segment_content() {
  __last_color=$2
  echo "${PL_COLORS[$1]}${PL_COLORS[On_$2]}$3"
}

#######################################
# Returns the host's IP address. Only called when a segment is explicitly
# configured to show an IP, since it is the one genuinely slow helper here.
# Outputs:
#   Writes the address to stdout.
#######################################
ip_address() {
  local ip_addr=''
  if [[ -x /sbin/ip || -x /usr/sbin/ip ]]; then
    ip_addr=$(ip route get 1 2>/dev/null | tr -s ' ' | cut -d' ' -f7)
  elif [[ -x /sbin/ifconfig ]]; then
    local -a line
    local candidate
    while IFS=$': \t' read -ra line; do
      if [[ -z ${line[0]#inet} ]]; then
        candidate=${line[1]}
        [[ ${candidate} != 127.0.0.1 ]] && ip_addr=${candidate}
      fi
    done < <(LANG=C /sbin/ifconfig 2>/dev/null)
  fi
  echo "${ip_addr:-127.0.0.1}"
}

#######################################
# Returns '#' for root and '$' for everyone else.
# Outputs:
#   Writes the character to stdout.
#######################################
prompt_char() {
  if (( EUID == 0 )); then
    echo '#'
  else
    echo '$'
  fi
}

# -----------------------------------------------------------------------------
# Built-in segments.
#
# Every segment takes the same two arguments, supplied by PL_SEGMENTS:
#   $1: background colour name
#   $2: foreground colour name
# A segment that has nothing to show must return without touching PS1.
# -----------------------------------------------------------------------------

#######################################
# The OS logo, matching starship's [os] module.
#
# starship's [os] carries no padding of its own, so the logo sits flush
# against the rounded cap that opens the line. This does the same when it is
# the first segment, and pads normally when it follows another segment or
# when there is no opening cap to sit against.
#
# Globals:
#   PL_SYMBOLS, __last_color
#######################################
os_segment() {
  local content="${PL_SYMBOLS[os]} "
  if [[ -n ${__last_color} || -z ${PL_SYMBOLS[segment_head]} ]]; then
    content=" ${content}"
  fi
  pl_add_segment "$1" "$2" "${content}"
}

#######################################
# The current user, optionally with the host.
#
# The names are read from the environment rather than left as bash's \u and
# \h escapes. Those are expanded by bash only after the prompt string has
# been assembled, which is too late to apply PL_USER_LOWERCASE to them.
# $USER and $HOSTNAME are shell variables, so reading them still costs
# nothing. If neither is set the \u / \h escapes are used as a fallback and
# lowercasing is skipped, since there is no string to fold at this point.
#
# Globals:
#   USER, LOGNAME, HOSTNAME, EUID, PL_USER_SHOW_HOST, PL_USER_USE_IP,
#   PL_USER_LOWERCASE
#######################################
user_segment() {
  local content host_name
  local uses_prompt_escape=false

  # EUID is authoritative: 'sudo bash' leaves $USER as the invoking user.
  if (( EUID == 0 )); then
    content=root
  else
    content=${USER:-${LOGNAME}}
  fi
  if [[ -z ${content} ]]; then
    content='\u'
    uses_prompt_escape=true
  fi

  if [[ ${PL_USER_SHOW_HOST} == true ]]; then
    if [[ ${PL_USER_USE_IP} == true ]]; then
      host_name=$(ip_address)
    else
      # Short form, matching \h: everything up to the first dot.
      host_name=${HOSTNAME%%.*}
      if [[ -z ${host_name} ]]; then
        host_name='\h'
        uses_prompt_escape=true
      fi
    fi
    content+="@${host_name}"
  fi

  if [[ ${PL_USER_LOWERCASE} != false && ${uses_prompt_escape} == false ]]; then
    content=${content,,}
  fi

  if [[ ${uses_prompt_escape} == true ]]; then
    pl_add_segment_raw "$1" "$2" " ${content} "
  else
    pl_add_segment "$1" "$2" " ${content} "
  fi
}

#######################################
# The working directory, with '~' for $HOME, optional truncation and
# optional per-directory icons. Mirrors starship's [directory] module.
# Globals:
#   PL_PATH_TRIM, PL_PATH_ALIASES, PL_SYMBOLS
#######################################
path_segment() {
  local path=${PWD}
  local -a parts
  local -i trim=${PL_PATH_TRIM:-0}
  local -i count keep index
  local part rendered=''

  # Collapse $HOME to '~'. Guard against $HOME being '/' or unset, which
  # would otherwise rewrite every path.
  if [[ -n ${HOME} && ${HOME} != / ]]; then
    if [[ ${path} == "${HOME}" ]]; then
      path='~'
    elif [[ ${path} == "${HOME}"/* ]]; then
      path="~${path#"${HOME}"}"
    fi
  fi

  if [[ ${path} == / ]]; then
    pl_add_segment "$1" "$2" ' / '
    return
  fi

  IFS=/ read -ra parts <<< "${path}"
  count=${#parts[@]}

  if (( trim == 1 )); then
    keep=1
  elif (( trim > 1 && count > trim )); then
    keep=${trim}
  else
    keep=${count}
  fi

  for (( index = count - keep; index < count; index++ )); do
    part=${parts[index]}
    [[ -z ${part} ]] && continue
    # An alias replaces a directory name with an icon, e.g. Downloads -> a
    # download glyph, exactly as starship's [directory.substitutions] does.
    [[ -n ${PL_PATH_ALIASES[${part}]+set} ]] && part=${PL_PATH_ALIASES[${part}]}
    rendered+="/${part}"
  done

  if (( keep < count )); then
    rendered="${PL_SYMBOLS[path_trimmed]}${rendered#/}"
  elif [[ ${parts[0]} == '~' ]]; then
    rendered=${rendered#/}
  fi

  pl_add_segment "$1" "$2" " ${rendered:-/} "
}

#######################################
# The current time. Uses bash's own \A / \t escapes, which cost nothing.
# Globals:
#   PL_TIME_SHOW_SECONDS, PL_SYMBOLS
#######################################
time_segment() {
  local content='\A'
  [[ ${PL_TIME_SHOW_SECONDS} == true ]] && content='\t'
  # Raw: \A and \t are bash prompt escapes, so only the symbol is escaped.
  __pl_escape "${PL_SYMBOLS[time]}"
  if [[ -n ${__pl_escaped} ]]; then
    content="${__pl_escaped} ${content}"
  fi
  pl_add_segment_raw "$1" "$2" " ${content} "
}

#######################################
# A marker when the working directory is not writable.
# Globals:
#   PL_SYMBOLS
#######################################
read_only_segment() {
  [[ -w ${PWD} ]] && return
  pl_add_segment "$1" "$2" " ${PL_SYMBOLS[read_only]} "
}

#######################################
# The number of background jobs.
#
# Counting jobs needs a command substitution, so it is skipped entirely
# until the shell has actually backgrounded something -- bash only sets $!
# once a job has been started, which makes it a free guard.
#
# Globals:
#   PL_SYMBOLS
#######################################
background_jobs_segment() {
  [[ -z ${!} ]] && return

  local -a running
  mapfile -t running < <(jobs -r -p)
  (( ${#running[@]} == 0 )) && return

  pl_add_segment "$1" "$2" " ${PL_SYMBOLS[background_jobs]} ${#running[@]} "
}

#######################################
# The exit status of the last command, when it failed.
# Globals:
#   __return_code, PL_SYMBOLS
#######################################
return_code_segment() {
  (( ${__return_code:-0} == 0 )) && return
  pl_add_segment "$1" "$2" \
      " ${PL_SYMBOLS[return_code]} ${__return_code} "
}

#######################################
# Ends the current line and starts a new one.
# Globals:
#   PS1, __last_color
#######################################
newline_segment() {
  __pl_close_line
  PS1+='\n'
}

#######################################
# The classic pureline '$' / '#' prompt character, as a filled segment.
# Globals:
#   PL_PROMPT_SHOW_SHLVL, PL_PROMPT_ROOT_BG, PL_PROMPT_ROOT_FG
#######################################
prompt_segment() {
  local bg=$1 fg=$2
  local shell_level=''

  if [[ ${PL_PROMPT_SHOW_SHLVL} == true ]]; then
    shell_level=${SHLVL}
  elif [[ ${PL_PROMPT_SHOW_SHLVL} == relative ]]; then
    [[ -v __pl_starting_shlvl ]] || export __pl_starting_shlvl=${SHLVL}
    shell_level=$(( SHLVL - __pl_starting_shlvl + 1 ))
  fi
  [[ ${shell_level} == 1 ]] && shell_level=''

  if (( EUID == 0 )); then
    [[ -n ${PL_PROMPT_ROOT_BG} ]] && bg=${PL_PROMPT_ROOT_BG}
    [[ -n ${PL_PROMPT_ROOT_FG} ]] && fg=${PL_PROMPT_ROOT_FG}
  fi

  local char='$'
  (( EUID == 0 )) && char='#'

  pl_add_segment "${bg}" "${fg}" " ${shell_level}${char} "
}

#######################################
# starship's [character] module: a bare prompt glyph with no background,
# green normally and red after a failed command.
#
# Unlike every other segment this one takes its colour from $2 as the
# success colour and ignores $1, because it has no background to fill.
#
# Globals:
#   PS1, __return_code, PL_SYMBOLS, PL_COLORS, PL_CHARACTER_ERROR_FG
#######################################
character_segment() {
  local fg=$2

  if (( ${__return_code:-0} != 0 )); then
    fg=${PL_CHARACTER_ERROR_FG:-Red}
  fi

  # __pl_close_line escapes the tail glyph into __pl_escaped, so escape the
  # prompt character only after it has run.
  __pl_close_line
  __pl_escape "${PL_SYMBOLS[character]}"
  PS1+="${PL_COLORS[On_Default]}${PL_COLORS[Bold]}${PL_COLORS[${fg}]}"
  PS1+="${__pl_escaped}${PL_COLORS[Color_Off]} "
}

# -----------------------------------------------------------------------------
# Command timing.
#
# The original implementation ran 'date +%s%N' from a DEBUG trap, forking a
# process before every command typed at the prompt -- and BSD date has no
# %N, so on macOS the result was never even valid. $EPOCHREALTIME is a bash
# 5 builtin holding seconds.microseconds, so this now costs nothing.
# -----------------------------------------------------------------------------

#######################################
# Records when the current command started. Called from the DEBUG trap.
# Globals:
#   EPOCHREALTIME, __pl_cmd_start, __pl_rendering
#######################################
__pl_timer_start() {
  # Commands run by PROMPT_COMMAND must not restart the clock, or the time
  # spent typing the next command would be counted as run time.
  [[ -n ${__pl_rendering} ]] && return
  [[ -n ${__pl_cmd_start} ]] && return
  # The separator in EPOCHREALTIME follows the locale, so match either.
  __pl_cmd_start=${EPOCHREALTIME/[.,]/}
}

# -----------------------------------------------------------------------------
# The 'pureline' command. Only runs when typed; it costs the prompt nothing.
# -----------------------------------------------------------------------------

#######################################
# Prints every palette name, sorted, one per line.
# Globals:
#   __PL_PALETTES
#######################################
__pl_theme_names() {
  printf '%s\n' "${!__PL_PALETTES[@]}" | sort
}

#######################################
# Lists the palettes with their descriptions; * marks the active one.
# Globals:
#   __PL_PALETTE_INFO, __PL_PALETTE_CURRENT
#######################################
__pl_theme_list() {
  local name mark
  while IFS= read -r name; do
    mark=' '
    [[ ${name} == "${__PL_PALETTE_CURRENT}" ]] && mark='*'
    printf '  %s %-22s %s\n' "${mark}" "${name}" "${__PL_PALETTE_INFO[${name}]}"
  done < <(__pl_theme_names)
}

#######################################
# Renders the real prompt in one or more palettes, then restores every
# colour, the prompt and the active palette exactly as they were.
# Globals:
#   PS1, PL_COLORS, __last_color, __return_code, __PL_PALETTE_CURRENT
# Arguments:
#   $@: palette names; every palette when none is given.
#######################################
__pl_theme_show() {
  local -a names=("$@")
  local -A saved_colors
  local saved_ps1=${PS1} saved_last=${__last_color}
  local saved_palette=${__PL_PALETTE_CURRENT}
  local key name

  (( ${#names[@]} == 0 )) && mapfile -t names < <(__pl_theme_names)
  for key in "${!PL_COLORS[@]}"; do
    saved_colors[${key}]=${PL_COLORS[${key}]}
  done

  for name in "${names[@]}"; do
    pl_load_palette "${name}" || continue
    __return_code=0
    __pureline_post
    printf '\e[2m%s\e[0m\n%s\n' "${name}" "${PS1@P}"
  done

  for key in "${!saved_colors[@]}"; do
    PL_COLORS[${key}]=${saved_colors[${key}]}
  done
  __PL_PALETTE_CURRENT=${saved_palette}
  PS1=${saved_ps1}
  __last_color=${saved_last}
}

#######################################
# Switches this shell to a palette without saving anything.
# Arguments:
#   $1: palette name.
#######################################
__pl_theme_test() {
  if [[ -z ${1:-} ]]; then
    echo 'usage: pureline theme test NAME' >&2
    return 1
  fi
  pl_load_palette "$1" || return 1
  echo "pureline: this shell now uses '$1'; not saved"
}

#######################################
# Switches to a palette and makes it the default by rewriting the config
# file's pl_load_palette line, or appending one. The file is written
# through rather than replaced, so a symlinked config stays a symlink.
# Globals:
#   __PL_CONFIG_FILE
# Arguments:
#   $1: palette name.
#######################################
__pl_theme_apply() {
  local name=${1:-} conf=${__PL_CONFIG_FILE}
  local tmp line comment previous='' replaced=false

  if [[ -z ${name} ]]; then
    echo 'usage: pureline theme apply NAME' >&2
    return 1
  fi
  if [[ -z ${conf} || ! -w ${conf} ]]; then
    echo 'pureline: no writable config file was loaded' >&2
    return 1
  fi
  pl_load_palette "${name}" || return 1

  tmp=${conf}.tmp.$$
  while IFS= read -r line || [[ -n ${line} ]]; do
    if [[ ${replaced} == false && ${line} == pl_load_palette* ]]; then
      # Keep any trailing comment; report only the old palette name.
      comment=''
      [[ ${line} == *'#'* ]] && comment="  #${line#*#}"
      previous=${line#pl_load_palette }
      previous=${previous%%#*}
      previous=${previous%"${previous##*[![:space:]]}"}
      printf 'pl_load_palette %s%s\n' "${name}" "${comment}"
      replaced=true
    else
      printf '%s\n' "${line}"
    fi
  done < "${conf}" > "${tmp}"
  if [[ ${replaced} == false ]]; then
    printf 'pl_load_palette %s\n' "${name}" >> "${tmp}"
  fi

  cat "${tmp}" > "${conf}" && rm -f "${tmp}"
  echo "pureline: ${conf} now loads '${name}'${previous:+ (was ${previous})}"
}

#######################################
# Prints usage for the pureline command.
#######################################
__pl_usage() {
  cat <<'EOF'
usage: pureline theme <command>

  list          available themes; * marks the active one
  show [NAME]   preview every theme, or one, using the real prompt
  test NAME     switch this shell to NAME; nothing is saved
  apply NAME    switch, and make NAME the default in the config file
EOF
}

#######################################
# Entry point for the 'pureline' command.
# Arguments:
#   $1: command group; only 'theme' so far.
#   $2: sub-command.
#   $@: the sub-command's arguments.
#######################################
pureline() {
  local group=${1:-} command=${2:-}
  (( $# >= 2 )) && shift 2

  case ${group}:${command} in
    theme:list) __pl_theme_list ;;
    theme:show) __pl_theme_show "$@" ;;
    theme:test) __pl_theme_test "$@" ;;
    theme:apply) __pl_theme_apply "$@" ;;
    *) __pl_usage; return 1 ;;
  esac
}

# -----------------------------------------------------------------------------
# Prompt driver.
# -----------------------------------------------------------------------------

#######################################
# Runs before the inherited PROMPT_COMMAND.
# Globals:
#   __return_code, __pl_rendering, PL_TITLEBAR
# Returns:
#   The exit status of the command that just finished.
#######################################
__pureline_pre() {
  __return_code=$?
  __pl_rendering=1

  if [[ -n ${PL_TITLEBAR} ]]; then
    # @P expands a string as if it were a prompt, so PL_TITLEBAR can use the
    # same \u \h \w escapes as PS1. It needs bash 4.4 or newer.
    if (( BASH_VERSINFO[0] > 4 ||
        (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )); then
      printf '\e]2;%s\a' "${PL_TITLEBAR@P}"
    else
      printf '\e]2;%s\a' "${PL_TITLEBAR}"
    fi
  fi

  return ${__return_code}
}

#######################################
# Builds PS1. Runs after the inherited PROMPT_COMMAND.
# Globals:
#   PS1, PL_SEGMENTS, __last_color, __return_code, __pl_rendering,
#   __pl_cmd_start, PL_ERASE_TO_EOL
#######################################
__pureline_post() {
  local segment

  PS1=''
  __last_color=''

  if (( ${#PL_SEGMENTS[@]} == 0 )); then
    PS1="PL | No segments loaded: $(prompt_char) "
    return
  fi

  for segment in "${PL_SEGMENTS[@]}"; do
    # Unquoted on purpose: each entry is "name Bg Fg" and must word-split
    # into a command and its two arguments.
    # shellcheck disable=SC2086
    ${segment}
  done

  # Close any run of segments the last one left open. A config ending in
  # character_segment has already closed it, and this is then a no-op.
  if [[ -n ${__last_color} ]]; then
    __pl_close_line
    PS1+=' '
  fi

  PS1+="${PL_COLORS[Color_Off]}"
  [[ ${PL_ERASE_TO_EOL} == true ]] && PS1+='\[\e[K\]'

  __last_color=''
  __return_code=0
  __pl_cmd_start=''
  __pl_rendering=''
}

#######################################
# Reads the ID field out of /etc/os-release, e.g. "fedora".
# Outputs:
#   Sets __pl_os_id; empty when the file has no ID or does not exist.
#######################################
__pl_os_release_id() {
  local line
  __pl_os_id=''
  [[ -r /etc/os-release ]] || return
  while IFS= read -r line; do
    if [[ ${line} == ID=* ]]; then
      __pl_os_id=${line#ID=}
      __pl_os_id=${__pl_os_id//\"/}
      return
    fi
  done < /etc/os-release
}

#######################################
# Decides whether to render with a plain glyph set rather than the Nerd
# Font one, and normalises PL_ASCII to exactly "true" or "false". An
# explicit PL_ASCII is honoured; otherwise ASCII is chosen for the bare
# Linux console and for any non-UTF-8 locale, where the glyphs cannot be
# drawn. Runs before the config is sourced, so the config can read it.
# Globals:
#   PL_ASCII, TERM, LC_ALL, LC_CTYPE, LANG
#######################################
__pl_resolve_ascii() {
  case ${PL_ASCII,,} in
    true | 1 | yes | on) PL_ASCII=true; return ;;
    false | 0 | no | off) PL_ASCII=false; return ;;
  esac

  local ctype=${LC_ALL:-${LC_CTYPE:-${LANG}}}
  if [[ ${TERM} == linux ]] \
      || [[ -n ${ctype} && ${ctype} != *[Uu][Tt][Ff]* ]]; then
    PL_ASCII=true
  else
    PL_ASCII=false
  fi
}

#######################################
# Detects the running OS and picks its logo, once, at startup.
# Globals:
#   OSTYPE, PL_SYMBOLS, PL_ASCII
#######################################
__pl_detect_os() {
  # Already set by the config? Leave it alone.
  [[ -n ${PL_SYMBOLS[os]} ]] && return

  # Without a Nerd Font the logo would be tofu, so use a short text label:
  # "mac", "win", or the distro id from /etc/os-release, else "linux".
  if [[ ${PL_ASCII} == true ]]; then
    case ${OSTYPE} in
      darwin*) PL_SYMBOLS[os]='mac'; return ;;
      msys* | cygwin* | win32) PL_SYMBOLS[os]='win'; return ;;
    esac
    __pl_os_release_id
    PL_SYMBOLS[os]=${__pl_os_id:-linux}
    return
  fi

  case ${OSTYPE} in
    darwin*)
      PL_SYMBOLS[os]=$'\U000f0035'  # Apple logo
      return
      ;;
    msys* | cygwin* | win32)
      PL_SYMBOLS[os]=$'\ue70f'  # Windows logo
      return
      ;;
  esac

  local distro=''
  if [[ -r /etc/os-release ]]; then
    local line
    while IFS= read -r line; do
      if [[ ${line} == ID=* ]]; then
        distro=${line#ID=}
        distro=${distro//\"/}
        break
      fi
    done < /etc/os-release
  fi

  case ${distro} in
    ubuntu) PL_SYMBOLS[os]=$'\U000f0548' ;;        # Ubuntu
    debian) PL_SYMBOLS[os]=$'\U000f08da' ;;        # Debian
    fedora) PL_SYMBOLS[os]=$'\U000f08db' ;;        # Fedora
    arch) PL_SYMBOLS[os]=$'\U000f08c7' ;;          # Arch
    manjaro) PL_SYMBOLS[os]=$'\uf312' ;;           # Manjaro
    alpine) PL_SYMBOLS[os]=$'\uf300' ;;            # Alpine
    centos) PL_SYMBOLS[os]=$'\uf304' ;;            # CentOS
    gentoo) PL_SYMBOLS[os]=$'\U000f08e8' ;;        # Gentoo
    linuxmint) PL_SYMBOLS[os]=$'\U000f08ed' ;;     # Linux Mint
    opensuse* | sles) PL_SYMBOLS[os]=$'\uf314' ;;  # openSUSE and SLES
    raspbian) PL_SYMBOLS[os]=$'\U000f043f' ;;      # Raspberry Pi OS
    rhel) PL_SYMBOLS[os]=$'\U000f111b' ;;          # Red Hat Enterprise Linux
    amzn) PL_SYMBOLS[os]=$'\uf270' ;;              # Amazon Linux
    *) PL_SYMBOLS[os]=$'\U000f033d' ;;             # Tux, any other distro
  esac
}

#######################################
# The default glyph set. Plain characters only, so that a terminal without a
# Nerd Font still produces a readable prompt; .pureline.conf overrides these
# with the powerline and Nerd Font glyphs.
# Globals:
#   PL_SYMBOLS
#######################################
__pl_set_default_symbols() {
  PL_SYMBOLS=(
    [segment_head]=''      # no cap without a powerline font
    [segment_tail]=''      # no cap without a powerline font
    [hard_separator]='▶'   # black right-pointing triangle
    [soft_separator]='│'   # box-drawing vertical line
    [path_trimmed]='.../'  # marks a shortened path
    [read_only]='RO'       # directory is not writable
    [return_code]='x'      # last command failed
    [background_jobs]='&'  # running background jobs
    [character]='>'        # the prompt character
    [time]='@'             # no clock glyph in plain text
  )
}

#######################################
# The default prompt, used when no config file is supplied.
# Globals:
#   PL_SEGMENTS, PL_USER_SHOW_HOST, PL_PATH_TRIM
#######################################
__pl_set_default_segments() {
  PL_SEGMENTS=(
    'user_segment      Yellow  Black'
    'path_segment      Blue    Black'
    'read_only_segment Red     White'
  )
  PL_USER_SHOW_HOST=true
  PL_PATH_TRIM=1
}

#######################################
# Sources the external segment file for every configured segment that is not
# already defined.
# Globals:
#   PL_SEGMENTS, BASH_SOURCE
#######################################
__pl_load_segments() {
  local segment_dir=${BASH_SOURCE[0]%/*}/segments
  local entry name

  for entry in "${PL_SEGMENTS[@]}"; do
    name=${entry%% *}
    if [[ -r ${segment_dir}/${name} ]]; then
      # Always source it, even when the function is already defined. The
      # previous "skip if already defined" guard meant that re-sourcing
      # pureline in a running shell silently kept the segment functions the
      # shell started with, so edits to a segment file never took effect and
      # a stale segment could be paired with a freshly loaded config.
      #
      # A consequence is that a segment file always wins over a function of
      # the same name defined in the config; give a custom segment its own
      # name rather than shadowing a shipped one.
      # shellcheck source=/dev/null
      source "${segment_dir}/${name}"
    elif [[ -z $(type -t "${name}") ]]; then
      echo "pureline: no such segment '${name}'" >&2
    fi
  done
}

#######################################
# Entry point. Sourced with an optional path to a config file. Removed again
# after it has run, so the interactive shell is not left with a 'main'.
# Arguments:
#   $1: path to a pureline config file.
#######################################
__pl_main() {
  __pl_supports_truecolor && __PL_TRUECOLOR=true
  __pl_resolve_ascii

  __pl_set_base_colors
  __pl_set_default_symbols
  __pl_set_default_segments

  PL_TITLEBAR='\u@\h: \w'  # may use PS1-style escapes
  PL_ERASE_TO_EOL=false    # some terminals need this to avoid artefacts

  # tmux manages its own pane titles.
  [[ -n ${TMUX} ]] && PL_TITLEBAR=''

  if [[ -f $1 ]]; then
    __PL_CONFIG_FILE=$1
    [[ $1 == /* ]] || __PL_CONFIG_FILE=${PWD}/$1
    # shellcheck source=/dev/null
    source "$1"
  fi

  __pl_detect_os
  __pl_load_segments

  # Time commands only when a segment asks for it. A DEBUG trap fires
  # before every command in the shell, so it is not installed speculatively.
  local entry
  for entry in "${PL_SEGMENTS[@]}"; do
    if [[ ${entry%% *} == duration_segment ]]; then
      trap '__pl_timer_start' DEBUG
      break
    fi
  done

  if [[ ${PROMPT_COMMAND} != *pureline_ps1* ]]; then
    # Wrapping the inherited PROMPT_COMMAND in a single function keeps
    # pureline compatible with tools that install their own prompt hooks,
    # such as the shell integration in VS Code's terminal.
    eval "pureline_ps1() {
      __pureline_pre
      ${PROMPT_COMMAND}
      __pureline_post
    }"
    PROMPT_COMMAND='pureline_ps1'
  fi
}

__pl_main "$@"
unset -f __pl_main
