# Ghostty configuration. Only options that differ from the defaults are set;
# `ghostty +show-config --default --docs` lists everything else.
#
# Cmd and Ctrl are swapped in the macOS keyboard settings, so the physical
# Ctrl key arrives as cmd. The text: bindings turn it back into the control
# characters a shell expects (cmd+c sends ^C, cmd+d sends ^D, and so on),
# which is why copy and paste sit on cmd+shift+c and cmd+shift+v.

auto-update-channel = tip
keybind = cmd+shift+e=new_split:down
keybind = cmd+shift+o=new_split:right

keybind = cmd+a=text:\x01
keybind = cmd+e=text:\x05
keybind = cmd+c=text:\x03
keybind = cmd+d=text:\x04
keybind = cmd+u=text:\x15
keybind = cmd+k=text:\x0b
keybind = cmd+l=text:\x0c
keybind = cmd+z=text:\x1a
keybind = cmd+r=text:\x12
keybind = cmd+w=text:\x17
keybind = cmd+backspace=text:\x17
keybind = cmd+shift+c=copy_to_clipboard
keybind = cmd+shift+v=paste_from_clipboard
keybind = cmd+shift+w=close_surface
keybind = cmd+left=text:\x1bb
keybind = cmd+right=text:\x1bf

scrollback-limit = 50000000

# The Claude Code status line draws its meters with U+25C9..U+25D5 (circle
# glyphs). The Nerd Font renders them too small, Menlo has them at the right
# size.
font-codepoint-map = U+25C9-U+25D5=Menlo

link-previews = false
