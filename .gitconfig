[alias]
  b       = branch -vv
  co      = "!f() { git switch \"$1\" 2>/dev/null || git switch -c \"$1\"; }; f"
  commit  = commit -v
  st      = status
  unstage = reset HEAD --

[branch]
  sort = -committerdate

[commit]
  gpgSign = true
  verbose = true

[core]
  autocrlf       = input
  editor         = vim
  fsmonitor      = true
  untrackedCache = true
  whitespace     = cr-at-eol

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true

[fetch]
  all = true
  prune = true
  pruneTags = true

[help]
  autocorrect = prompt

[merge]
  conflictstyle = zdiff3

[pull]
  rebase = true

[push]
  autoSetupRemote = true
  followTags = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[rerere]
  enabled = true
  autoupdate = true

[tag]
  gpgSign = true
  sort = version:refname

[user]
  email = patrik@redlin.se
  name = "Patrik Martinsson"
  signingkey = 34D050E6196164D28DB527BA9233DCB79B567F05

[advice]
  defaultBranchName = false

# Machine-specific settings (gpg.program, diff/merge tools that are only
# installed on some hosts) live in ~/.gitconfig.local, which is not tracked.
# Last, so that it overrides anything above.
[include]
  path = ~/.gitconfig.local
