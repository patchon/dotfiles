#!/usr/bin/env bash
#
# ssh_segment - shown only when the shell is on the far end of an ssh
# connection.

[[ -z ${PL_SYMBOLS[ssh]} ]] && PL_SYMBOLS[ssh]='ssh'  # remote session

#######################################
# Appends an ssh indicator, optionally with the host.
# Globals:
#   SSH_CLIENT, SSH_TTY, SSH_CONNECTION, PL_SSH_SHOW_HOST, PL_SSH_USE_IP
# Arguments:
#   $1: background colour name.
#   $2: foreground colour name.
#######################################
ssh_segment() {
  [[ -z ${SSH_CLIENT} && -z ${SSH_TTY} && -z ${SSH_CONNECTION} ]] && return 0

  local content=${PL_SYMBOLS[ssh]}

  if [[ ${PL_SSH_SHOW_HOST} == true ]]; then
    if [[ ${PL_SSH_USE_IP} == true ]]; then
      # SSH_CONNECTION is "client_ip client_port server_ip server_port", so
      # the server address is already here and needs no ifconfig call.
      local -a connection
      read -ra connection <<< "${SSH_CONNECTION}"
      content+=" ${connection[2]:-\\h}"
    else
      content+=' \h'
    fi
  fi

  # Raw: \h is a bash prompt escape and must reach PS1 intact.
  pl_add_segment_raw "$1" "$2" " ${content} "
}
