#!/usr/bin/env bash
#
# kubernetes_segment - the current kubectl context and namespace.
#
# The original ran 'kubectl config current-context' and 'kubectl config
# view' on every prompt. kubectl takes 100ms or more to start, so those two
# calls alone could cost more than everything else in the prompt combined.
#
# The same two values live in the kubeconfig file, so this reads them
# directly with a small line-by-line scan and never runs kubectl at all.

[[ -z ${PL_SYMBOLS[kubernetes]} ]] && PL_SYMBOLS[kubernetes]='k8s'

#######################################
# Extracts the value from a "key: value" line, dropping quotes and any
# trailing comment.
# Arguments:
#   $1: the line.
# Outputs:
#   Writes nothing; sets __pl_kube_value.
#######################################
__pl_kube_value() {
  local value=${1#*:}
  # Trim surrounding whitespace.
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  value=${value#\"}; value=${value%\"}
  value=${value#\'}; value=${value%\'}
  __pl_kube_value=${value}
}

#######################################
# Reads the current context and its namespace out of a kubeconfig file.
#
# The file lists each context as a block whose 'name:' comes after its
# 'namespace:', so the namespace seen most recently is remembered and
# committed once a matching name is reached.
#
# Arguments:
#   $1: path to a kubeconfig file.
# Outputs:
#   Sets __pl_kube_context and __pl_kube_namespace.
# Returns:
#   0 if a current context was found, 1 otherwise.
#######################################
__pl_kube_parse() {
  local file=$1
  local line trimmed
  local current='' pending_ns='' found_ns=''

  [[ -r ${file} ]] || return 1

  while IFS= read -r line || [[ -n ${line} ]]; do
    trimmed=${line#"${line%%[![:space:]]*}"}
    case ${trimmed} in
      'current-context:'*)
        __pl_kube_value "${trimmed}"
        current=${__pl_kube_value}
        ;;
      '- context:'* | '-context:'*)
        pending_ns=''
        ;;
      'namespace:'*)
        __pl_kube_value "${trimmed}"
        pending_ns=${__pl_kube_value}
        ;;
      'name:'*)
        __pl_kube_value "${trimmed}"
        if [[ -n ${current} && ${__pl_kube_value} == "${current}" ]]; then
          found_ns=${pending_ns}
        fi
        # Remember it in case current-context appears later in the file.
        __pl_kube_names[${__pl_kube_value}]=${pending_ns}
        pending_ns=''
        ;;
    esac
  done < "${file}"

  [[ -z ${current} ]] && return 1

  __pl_kube_context=${current}
  if [[ -n ${found_ns} ]]; then
    __pl_kube_namespace=${found_ns}
  else
    __pl_kube_namespace=${__pl_kube_names[${current}]}
  fi
  return 0
}

#######################################
# Appends the kubernetes context, and namespace when one is set.
# Globals:
#   KUBECONFIG, HOME, PL_SYMBOLS, PL_KUBE_SHOW_DEFAULT_NS
# Arguments:
#   $1: background colour name.
#   $2: foreground colour name.
#######################################
kubernetes_segment() {
  local config=${KUBECONFIG:-${HOME}/.kube/config}
  # KUBECONFIG may list several files; the first one wins here.
  config=${config%%:*}

  unset __pl_kube_names; declare -A __pl_kube_names
  __pl_kube_context=''
  __pl_kube_namespace=''

  __pl_kube_parse "${config}" || return 0
  [[ -z ${__pl_kube_context} ]] && return 0

  local content="${PL_SYMBOLS[kubernetes]} ${__pl_kube_context}"
  if [[ -n ${__pl_kube_namespace} ]]; then
    if [[ ${__pl_kube_namespace} != default ||
        ${PL_KUBE_SHOW_DEFAULT_NS} == true ]]; then
      content+=":${__pl_kube_namespace}"
    fi
  fi

  pl_add_segment "$1" "$2" " ${content} "
}
