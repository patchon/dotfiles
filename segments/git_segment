#!/usr/bin/env bash
#
# git_segment - branch and working-tree state.
#
# The original version shelled out about ten times per prompt: 'which git',
# then a separate git invocation for the branch, the stash, ahead/behind,
# staged, conflicts, modified and untracked counts, most of them piped
# through wc or grep. On this machine each of those costs roughly 5.5ms of
# process spawn alone, which is where ~130ms of prompt latency came from.
#
# This version costs exactly one git invocation, and none at all outside a
# repository:
#   - the repository is found by walking up the tree in bash, so a
#     non-repository directory never spawns anything;
#   - 'git status --porcelain=v2 --branch' reports the branch, upstream
#     divergence and every file state in one pass, parsed here in bash;
#   - the stash count is read straight out of .git/logs/refs/stash.

#######################################
# Sets a symbol only when the config has not defined one. These fallbacks
# are plain text, so the segment stays readable without a Nerd Font.
# Globals:
#   PL_SYMBOLS
# Arguments:
#   $1: symbol name.
#   $2: fallback text.
#######################################
__pl_git_default() {
  [[ -n ${PL_SYMBOLS[$1]} ]] || PL_SYMBOLS[$1]=$2
}

__pl_git_default git_branch '╬'     # plain-text branch marker
__pl_git_default git_detached '@'   # detached HEAD
__pl_git_default git_untracked '?'  # untracked file
__pl_git_default git_stash '§'      # stash entries
__pl_git_default git_ahead '↑'      # commits ahead of upstream
__pl_git_default git_behind '↓'     # commits behind upstream
__pl_git_default git_modified '+'   # changed in the working tree
__pl_git_default git_staged '•'     # staged in the index
__pl_git_default git_deleted '-'    # deleted file
__pl_git_default git_conflicts '*'  # merge conflict

#######################################
# Finds the .git directory for $PWD by walking up the tree, without forking.
#
# Handles the plain case (.git is a directory), and worktrees and submodules
# (.git is a file holding 'gitdir: <path>').
#
# Globals:
#   PWD, GIT_DIR
# Outputs:
#   Sets __pl_git_dir to the repository's git directory.
# Returns:
#   0 if $PWD is inside a repository, 1 otherwise.
#######################################
__pl_git_find_dir() {
  local dir=${PWD}
  local marker pointer

  if [[ -n ${GIT_DIR} ]]; then
    __pl_git_dir=${GIT_DIR}
    return 0
  fi

  while [[ -n ${dir} ]]; do
    marker=${dir}/.git
    if [[ -d ${marker} ]]; then
      __pl_git_dir=${marker}
      return 0
    fi
    if [[ -f ${marker} ]]; then
      # "gitdir: /abs/or/relative/path"
      read -r _ pointer < "${marker}"
      [[ ${pointer} != /* ]] && pointer=${dir}/${pointer}
      __pl_git_dir=${pointer}
      return 0
    fi
    dir=${dir%/*}
  done

  if [[ -d /.git ]]; then
    __pl_git_dir=/.git
    return 0
  fi

  __pl_git_dir=''
  return 1
}

#######################################
# Counts stash entries by reading the stash reflog directly. Every stash
# push appends one line to it, so the line count is the stash count.
# Arguments:
#   $1: the repository's git directory.
# Outputs:
#   Sets __pl_git_stash.
#######################################
__pl_git_stash_count() {
  local stash_log=$1/logs/refs/stash
  local line

  __pl_git_stash=0
  [[ -r ${stash_log} ]] || return 0

  while IFS= read -r line || [[ -n ${line} ]]; do
    (( ++__pl_git_stash ))
  done < "${stash_log}"
}

#######################################
# Appends the git segment.
#
# Globals:
#   PL_SYMBOLS, PL_GIT_* option flags, PL_GIT_SHOW_COUNTS,
#   PL_GIT_DIRTY_BG, PL_GIT_DIRTY_FG
# Arguments:
#   $1: background colour name.
#   $2: foreground colour name.
#######################################
git_segment() {
  local bg=$1 fg=$2

  __pl_git_find_dir || return 0

  local -a status_lines
  # The one and only fork in this segment.
  mapfile -t status_lines < <(
    git status --porcelain=v2 --branch --ignore-submodules=dirty 2>/dev/null
  )
  (( ${#status_lines[@]} == 0 )) && return 0

  local branch='' oid='' upstream=''
  local -i ahead=0 behind=0
  local -i staged=0 modified=0 deleted=0 conflicts=0 untracked=0
  local -i dirty=0
  local line xy divergence

  for line in "${status_lines[@]}"; do
    case ${line} in
      '# branch.head '*)
        branch=${line:14}
        ;;
      '# branch.oid '*)
        oid=${line:13}
        ;;
      '# branch.upstream '*)
        upstream=${line:18}
        ;;
      '# branch.ab '*)
        # "+2 -1"
        divergence=${line:12}
        ahead=${divergence%% *}
        behind=${divergence##* }
        ;;
      '1 '* | '2 '*)
        # "1 XY ..." where X is the index state and Y the worktree state.
        xy=${line:2:2}
        [[ ${xy:0:1} != '.' ]] && (( ++staged ))
        case ${xy:1:1} in
          'D') (( ++deleted )) ;;
          '.') ;;
          *) (( ++modified )) ;;
        esac
        ;;
      'u '*)
        (( ++conflicts ))
        ;;
      '? '*)
        (( ++untracked ))
        ;;
    esac
  done

  local content count
  if [[ ${branch} == '(detached)' || -z ${branch} ]]; then
    content="${PL_SYMBOLS[git_detached]} ${oid:0:7}"
  else
    content="${PL_SYMBOLS[git_branch]} ${branch}"
  fi

  if [[ ${PL_GIT_STASH} == true ]]; then
    __pl_git_stash_count "${__pl_git_dir}"
    if (( __pl_git_stash > 0 )); then
      count=${__pl_git_stash}
      [[ ${PL_GIT_SHOW_COUNTS} == false ]] && count=''
      content+=" ${PL_SYMBOLS[git_stash]}${count}"
    fi
  fi

  if [[ ${PL_GIT_AHEAD} == true && -n ${upstream} ]]; then
    (( ahead > 0 )) && content+=" ${PL_SYMBOLS[git_ahead]}${ahead#+}"
    (( behind < 0 )) && content+=" ${PL_SYMBOLS[git_behind]}${behind#-}"
  fi

  # starship shows a bare symbol per state; counts are more informative, so
  # they are on by default and PL_GIT_SHOW_COUNTS=false restores the
  # starship look exactly.
  if [[ ${PL_GIT_STAGED} == true ]] && (( staged > 0 )); then
    count=${staged}
    [[ ${PL_GIT_SHOW_COUNTS} == false ]] && count=''
    content+=" ${PL_SYMBOLS[git_staged]}${count}"
  fi
  if [[ ${PL_GIT_CONFLICTS} == true ]] && (( conflicts > 0 )); then
    count=${conflicts}
    [[ ${PL_GIT_SHOW_COUNTS} == false ]] && count=''
    content+=" ${PL_SYMBOLS[git_conflicts]}${count}"
  fi
  if [[ ${PL_GIT_MODIFIED} == true ]] && (( modified > 0 )); then
    count=${modified}
    [[ ${PL_GIT_SHOW_COUNTS} == false ]] && count=''
    content+=" ${PL_SYMBOLS[git_modified]}${count}"
  fi
  if [[ ${PL_GIT_DELETED} == true ]] && (( deleted > 0 )); then
    count=${deleted}
    [[ ${PL_GIT_SHOW_COUNTS} == false ]] && count=''
    content+=" ${PL_SYMBOLS[git_deleted]}${count}"
  fi
  if [[ ${PL_GIT_UNTRACKED} == true ]] && (( untracked > 0 )); then
    count=${untracked}
    [[ ${PL_GIT_SHOW_COUNTS} == false ]] && count=''
    content+=" ${PL_SYMBOLS[git_untracked]}${count}"
  fi

  dirty=$(( staged + modified + deleted + conflicts + untracked ))
  if (( dirty > 0 )); then
    [[ -n ${PL_GIT_DIRTY_BG} ]] && bg=${PL_GIT_DIRTY_BG}
    [[ -n ${PL_GIT_DIRTY_FG} ]] && fg=${PL_GIT_DIRTY_FG}
  fi

  pl_add_segment "${bg}" "${fg}" " ${content} "
}
